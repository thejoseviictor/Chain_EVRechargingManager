# Informações do Ganache:
GANACHE_URL=http://localhost:8545
DEPLOYER_PRIVATE_KEY=0 # Substituir Pela Chave Privada do Owner, Conta "0".
ECOCHARGE_ACCOUNT=9
EFLUX_ACCOUNT=8
VOLTPOINT_ACCOUNT=7

# Configurações do Terminal:
PYTHONUNBUFFERED=1 # Habilitando a Exibição dos Prints no Terminal.

# Informações de Rede Dos Servidores das Empresas:
ECOCHARGE_SERVER_IP=localhost # IP do End-Point do Servidor da Empresa "EcoCharge".
ECOCHARGE_SERVER_PORT=64000 # Porta do End-Point do Servidor da Empresa "EcoCharge".
EFLUX_SERVER_IP=localhost # IP do End-Point do Servidor da Empresa "E-Flux".
EFLUX_SERVER_PORT=64111 # Porta do End-Point do Servidor da Empresa "E-Flux".
VOLTPOINT_SERVER_IP=localhost # IP do End-Point do Servidor da Empresa "VoltPoint".
VOLTPOINT_SERVER_PORT=64222 # Porta do End-Point do Servidor da Empresa "VoltPoint".

# Informações da API do Owner:
OWNER_IP=0.0.0.0
OWNER_PORT=64333
